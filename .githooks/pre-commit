#
# Refuse a commit that stages game content, keys or generated game code.
# Install once per clone:  cp .githooks/pre-commit .git/hooks/pre-commit
# (git config core.hooksPath .githooks also enables the maintainer's pre-push guard.)
# Never bypass it with --no-verify. If it flags a file by mistake, fix the
# check in a separate pull request and say why.

root=$(git rev-parse --show-toplevel) || exit 1

for candidate in python3 python "py -3"; do
    if $candidate -c "import sys; sys.exit(sys.version_info < (3, 9))" >/dev/null 2>&1; then
        exec $candidate "$root/tools/check_content.py" --staged
    fi
done

echo "pre-commit: no usable Python 3.9+ found, so the content check cannot run." >&2
echo "Install Python 3 and try again. The commit is refused rather than unchecked." >&2
exit 1

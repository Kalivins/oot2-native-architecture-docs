// Fill: writes one 32-bit value into the first count words of a storage buffer, one word per invocation. The runtime's
// first shader of its own, kept trivial: it takes the route every later one takes (GLSL here, compiled for Vulkan 1.3
// and validated by glslang at each build of the runtime library, embedded in the program; tools/build_game.py,
// oot2/gpu.h), so the GOB untile, the ASTC decode, the BC encoder and the mesh indirect conversion only add a file.
#version 460

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) writeonly buffer Words {
    uint words[];
};

layout(push_constant) uniform Fill {
    uint value;
    uint count;
} fill;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < fill.count) words[i] = fill.value;
}

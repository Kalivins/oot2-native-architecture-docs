<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later
  Copyright (C) 2026 The oot2-native contributors

  Package sources for the translator build. Only nuget.org, so that a restore
  does not depend on the sources configured on the machine (an empty user
  configuration otherwise leaves no source at all).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

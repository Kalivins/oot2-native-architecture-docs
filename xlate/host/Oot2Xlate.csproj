  oot2-xlate: Switch 2 (Ampere sm_86) shader programs to SPIR-V for Vulkan 1.3.
  Build with tools/build_xlate.py (NativeAOT, outputs under build/xlate).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>oot2-xlate</AssemblyName>
    <RootNamespace>Oot2.Xlate</RootNamespace>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Translator time per program is part of the host's contract, so the
         collector must not run on another thread while a job is measured. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- A NativeAOT executable carries its runtime. 10.0.0, which the 10.0.100
         SDK selects, is affected by advisory GHSA-p3jp-9v83-76w9 (a Brotli
         decoder out-of-bounds write, fixed in 10.0.14), so the
         runtime and the compiler are pinned until the SDK moves past it. -->
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../third_party/ryujinx/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="../third_party/ryujinx/src/Ryujinx.Common/Ryujinx.Common.csproj" />
  </ItemGroup>
</Project>
